# TruthLens AI — Environment Configuration

# API base URL for the backend analysis service.
# Leave empty or unset to use Demo Mode (sample data, no backend required).
# Example: http://localhost:8000
VITE_API_BASE_URL=

# Demo Mode toggle.
# Set to "true" to use sample data (default).
# Set to "false" to send real requests to the backend specified above.
VITE_DEMO_MODE=true
