# API limits
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=40000000
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare R2 is disabled and disconnected from user-image handling by default.
# SECURITY: Never commit real credentials. Use placeholders only.
R2_ENABLED=false
R2_ACCOUNT_ID=your_account_id_here
R2_BUCKET=deepfake
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_FACEFORENSICSPP_PREFIX=faceforensics++
R2_CIFAKE_PREFIX=CIfake
